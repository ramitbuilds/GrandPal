# GrandPal Environment Configuration Example
# Copy this file to .env.local and fill in your values

# Google Gemini API Key for conversational AI & Doctor Pup triage
# Get your free key at: https://aistudio.google.com/apikey
# Note: Google AI Studio now issues new Authorization Keys starting with "AQ." (e.g. AQ.Ab8R...)
GEMINI_API_KEY="AQ.Ab8R..."

# Database URL (SQLite default)
DATABASE_URL="file:./dev.db"

# Optional Email Alert Configuration (for caregiver email notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# CAREGIVER_ALERT_EMAIL="caregiver@example.com"
